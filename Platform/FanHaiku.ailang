// Phase 4 Haiku build has no fan threads. The descriptor swap that
// starts curl is safe only while a single thread is running.
// Init returns 0. Shutdown does not join.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. MIT.

Function.PlatformFan_Init {
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.PlatformFan_Shutdown {
    Body: {
        ReturnValue(0)
    }
}
