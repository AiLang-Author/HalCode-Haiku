Function.PlatformFan_Init {
    Output: Integer
    Body: {
        ReturnValue(CCFan_Init())
    }
}

Function.PlatformFan_Shutdown {
    Body: {
        CCFan_Shutdown()
        ReturnValue(0)
    }
}
